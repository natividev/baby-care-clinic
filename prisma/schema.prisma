// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuarios {
  id         Int          @id @default(autoincrement())
  nombre     String
  usuario    String       @unique
  correo     String?      @unique
  password   String
  atenciones atenciones[]
}

enum genero {
  Masculino
  Femenino
}

model Paciente {
  id               Int      @id @default(autoincrement())
  nombre           String   @db.VarChar(100)
  apellidos        String   @db.VarChar(100)
  fecha_nacimiento DateTime @db.Date
  edad             Int
  telefono         String   @db.VarChar(15)
  email            String?  @unique @db.VarChar(100)
  genero           genero
  estado           Boolean  @default(true)

  citas      Citas[]
  Consultas  Consultas[]
  atenciones atenciones[]

  @@map("pacientes")
}

model aseguradoras {
  id         Int          @id @default(autoincrement())
  nombre     String       @db.VarChar(100)
  created_At DateTime     @default(now())
  updated_At DateTime     @updatedAt
  atenciones atenciones[]
}

enum tipo_ingreso {
  INGRESO_NORMAL
  AMBULATORIO
  URGENCIA
  PRE_OPERATORIO
  MATERNIDAD
  POST_OPERATORIO
}

enum tipo_pago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CHEQUE
  MEDICO_ES_RESPONSABLE_DE_LA_CUENTA
  SEGURO_MEDICO
  TRATO_CERRADO
}

model atenciones {
  id             Int          @id @default(autoincrement())
  tipo_ingreso   tipo_ingreso
  aseguradora_id Int?
  medico_id      Int?
  alta           Boolean      @default(false)
  username       Int?
  fecha_alta     DateTime?
  usuario_alta   Int?
  paciente_id    Int
  usuario_id     Int

  aseguradora aseguradoras? @relation(fields: [aseguradora_id], references: [id])
  medico      Medicos?      @relation(fields: [medico_id], references: [id])
  paciente    Paciente      @relation(fields: [paciente_id], references: [id])
  usuario     Usuarios?     @relation(fields: [usuario_id], references: [id])
  Consultas   Consultas[]
}

model Consultas {
  id                 Int        @id @default(autoincrement())
  fecha              DateTime
  motivo             String     @db.Text
  sintomas           String     @db.Text
  diagnostico        String     @db.Text
  peso               Float
  talla              Float
  pulso              Int
  temperatura        Float
  presion_arterial   String     @db.VarChar(10)
  inspeccion_general String     @db.Text
  id_medico          Int
  id_paciente        Int
  id_atencion        Int
  paciente           Paciente   @relation(fields: [id_paciente], references: [id])
  medico             Medicos    @relation(fields: [id_medico], references: [id])
  atencion           atenciones @relation(fields: [id_atencion], references: [id])
}

model Medicos {
  id                         Int                @id @default(autoincrement())
  nombre                     String             @db.VarChar(100)
  apellidos                  String             @db.VarChar(100)
  telefono                   String             @db.VarChar(15)
  jvpm                       String             @unique @db.VarChar(10)
  documento_de_identidad     String             @unique @db.VarChar(14)
  nrc                        String?            @unique @db.VarChar(10)
  especialidad               Int
  correo                     String?            @unique @db.VarChar(100)
  estado                     Boolean            @default(true)
  actividad_economica_codigo String             @db.VarChar(5)
  actividadEconomica         actividadEconomica @relation(fields: [actividad_economica_codigo], references: [codigo])
  citas                      Citas[]

  specialty  Specialties  @relation(fields: [especialidad], references: [id])
  Consultas  Consultas[]
  atenciones atenciones[]

  @@map("medicos")
}

model actividadEconomica {
  codigo             String    @id(map: "pk_sv_cat_019") @db.VarChar(5)
  nombre             String?   @db.VarChar(200)
  pais               String    @default("SV") @db.Char(2)
  estado             String    @default("Activo") @db.Char(12)
  creado_por         String    @db.VarChar(15)
  fecha_creacion     DateTime  @default(now()) @db.Timestamp(6)
  modificado_por     String?   @db.VarChar(15)
  fecha_modificacion DateTime? @db.Timestamp(6)
  medicos            Medicos[]

  @@map("actividad_economica")
}

model Citas {
  id         Int      @id @default(autoincrement())
  fecha_hora DateTime @db.Timestamp(6)
  id_paciente Int
  paciente    Paciente @relation(fields: [id_paciente], references: [id])
  id_medico Int
  medico    Medicos @relation(fields: [id_medico], references: [id])
  observaciones String @db.Text

  @@map("citas")
}

model Specialties {
  id      Int       @id @default(autoincrement())
  name    String    @unique
  medicos Medicos[]

  @@map("specialties")
}

model pais {
  codigo             String    @id(map: "pk_sv_cat_020") @db.VarChar(4)
  nombre             String?   @db.VarChar(100)
  estado             String    @default("Activo") @db.Char(12)
  creado_por         String    @db.VarChar(15)
  fecha_creacion     DateTime  @default(now()) @db.Timestamp(6)
  modificado_por     String?   @db.VarChar(15)
  fecha_modificacion DateTime? @db.Timestamp(6)
}

model departamento {
  codigo             String      @id(map: "pk_sv_cat_012") @db.VarChar(2)
  nombre             String?     @db.VarChar(100)
  estado             String      @default("Activo") @db.Char(12)
  creado_por         String      @db.VarChar(15)
  fecha_creacion     DateTime    @default(now()) @db.Timestamp(6)
  modificado_por     String?     @db.VarChar(15)
  fecha_modificacion DateTime?   @db.Timestamp(6)
  municipio          municipio[]
}

model municipio {
  codigo              String       @db.VarChar(2)
  nombre              String?      @db.VarChar(100)
  codigo_departamento String       @db.VarChar(2)
  estado              String       @default("Activo") @db.Char(12)
  creado_por          String       @db.VarChar(15)
  fecha_creacion      DateTime     @default(now()) @db.Timestamp(6)
  modificado_por      String?      @db.VarChar(15)
  fecha_modificacion  DateTime?    @db.Timestamp(6)
  departamento        departamento @relation(fields: [codigo_departamento], references: [codigo], onDelete: NoAction, onUpdate: NoAction, map: "municipio")

  @@id([codigo, codigo_departamento], map: "pk_sv_cat_013")
}
