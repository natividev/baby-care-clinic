// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuarios {
  id       Int     @id @default(autoincrement())
  nombre   String
  usuario  String  @unique
  correo   String? @unique
  password String
}

enum genero {
  Masculino
  Femenino
}

model Paciente {
  id               Int      @id @default(autoincrement())
  nombre           String
  apellidos        String
  fecha_nacimiento DateTime @db.Date
  edad             Int
  correo           String?  @unique
  telefono         String
  email            String   @unique
  genero           genero
  estado           Boolean  @default(true)

  citas Citas[]

  @@map("pacientes")
}

model Medicos {
  id                       Int                @id @default(autoincrement())
  nombre                   String
  apellidos                String
  telefono                 String
  jvpm                     String             @unique
  documentoDeIdentidad     String             @unique
  nrc                      String?            @unique
  especialidad             Int                @unique
  correo                   String?            @unique
  estado                   Boolean            @default(true)
  actividadEconomicaCodigo String             @db.VarChar(5)
  actividadEconomica       actividadEconomica @relation(fields: [actividadEconomicaCodigo], references: [codigo])
  citas                    Citas[]

  specialty Specialties @relation(fields: [especialidad], references: [id])

  @@map("medicos")
}

model actividadEconomica {
  codigo             String    @id(map: "pk_sv_cat_019") @db.VarChar(5)
  nombre             String?   @db.VarChar(200)
  pais               String    @default("SV") @db.Char(2)
  estado             String    @default("Activo") @db.Char(12)
  creado_por         String    @db.VarChar(15)
  fecha_creacion     DateTime  @default(now()) @db.Timestamp(6)
  modificado_por     String?   @db.VarChar(15)
  fecha_modificacion DateTime? @db.Timestamp(6)
  medicos            Medicos[]

  @@map("actividad_economica")
}

model Citas {
  id         Int      @id @default(autoincrement())
  fecha_hora DateTime

  idPaciente Int
  paciente   Paciente @relation(fields: [idPaciente], references: [id])

  idMedico Int
  medico   Medicos @relation(fields: [idMedico], references: [id])

  observaciones String @db.Text

  @@map("citas")
}

model Specialties {
  id     Int      @id @default(autoincrement())
  name   String   @unique
  medico Medicos?

  @@map("specialties")
}

model pais {
  codigo             String    @id(map: "pk_sv_cat_020") @db.VarChar(4)
  nombre             String?   @db.VarChar(100)
  estado             String    @default("Activo") @db.Char(12)
  creado_por         String    @db.VarChar(15)
  fecha_creacion     DateTime  @default(now()) @db.Timestamp(6)
  modificado_por     String?   @db.VarChar(15)
  fecha_modificacion DateTime? @db.Timestamp(6)
}

model departamento {
  codigo             String      @id(map: "pk_sv_cat_012") @db.VarChar(2)
  nombre             String?     @db.VarChar(100)
  estado             String      @default("Activo") @db.Char(12)
  creado_por         String      @db.VarChar(15)
  fecha_creacion     DateTime    @default(now()) @db.Timestamp(6)
  modificado_por     String?     @db.VarChar(15)
  fecha_modificacion DateTime?   @db.Timestamp(6)
  municipio          municipio[]
}

model municipio {
  codigo              String       @db.VarChar(2)
  nombre              String?      @db.VarChar(100)
  codigo_departamento String       @db.VarChar(2)
  estado              String       @default("Activo") @db.Char(12)
  creado_por          String       @db.VarChar(15)
  fecha_creacion      DateTime     @default(now()) @db.Timestamp(6)
  modificado_por      String?      @db.VarChar(15)
  fecha_modificacion  DateTime?    @db.Timestamp(6)
  departamento        departamento @relation(fields: [codigo_departamento], references: [codigo], onDelete: NoAction, onUpdate: NoAction, map: "municipio")

  @@id([codigo, codigo_departamento], map: "pk_sv_cat_013")
}
